# Cube Core Self-Host API configuration
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_TOKEN=devsecret

# Apache Superset embed URL.
SUPERSET_EMBED_URL=http://localhost:8088/superset/dashboard/1/?standalone=true



# Groq API configuration
GROQ_API_KEY=your_groq_api_key_here
NLU_MODEL=llama-3.3-70b-versatile
NLG_MODEL=llama-3.1-8b-instant

# Semantic Sample Values Path
SAMPLE_VALUES_PATH=semantic/sample_values.yaml

# Guardrails & Model settings
MAX_REPAIR_ATTEMPTS=1
MAX_ROW_LIMIT=1000
DEFAULT_RELATIVE_PERIOD="last 30 days"
