# Copy file này thành .env rồi điền giá trị thật (.env đã bị gitignore, không commit).

# Cube Core Self-Host API configuration
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_TOKEN=devsecret

# Apache Superset embed URL.
SUPERSET_EMBED_URL=http://localhost:8088/superset/dashboard/1/?standalone=true

# ============================================================
# LLM Provider configuration
# Đổi provider bằng cách sửa LLM_PROVIDER — KHÔNG cần sửa code.
# Giá trị hỗ trợ: openai (mặc định) | groq | google | openrouter
# Chỉ cần điền API key của provider đang chọn, các key khác để trống cũng được.
# ============================================================
LLM_PROVIDER=openai

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
# NLU_MODEL/NLG_MODEL "chung" bên dưới chỉ áp dụng khi LLM_PROVIDER=groq.
NLU_MODEL=llama-3.3-70b-versatile
NLG_MODEL=llama-3.1-8b-instant

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_NLU_MODEL=gpt-4o-mini
# OPENAI_NLG_MODEL=gpt-4o-mini

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_NLU_MODEL=gemini-2.0-flash
# GOOGLE_NLG_MODEL=gemini-2.0-flash

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_NLU_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_NLG_MODEL=meta-llama/llama-3.1-8b-instruct

# Semantic Sample Values Path
SAMPLE_VALUES_PATH=semantic/sample_values.yaml

# Guardrails & Model settings
MAX_REPAIR_ATTEMPTS=1
MAX_ROW_LIMIT=1000
DEFAULT_RELATIVE_PERIOD="last 30 days"
